# Copy to backend/.env and fill only the providers you intend to smoke-test.
# Never commit backend/.env.
APP_MODE=live
LLM_PROVIDER=groq
EXTERNAL_PROVIDERS_ENABLED=true
LIVE_TOOL_FALLBACK_TO_LOCAL=false

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=12

SERPAPI_API_KEY=
STAYING_API_KEY=
GEOAPIFY_PLACES_API_KEY=
GEOAPIFY_ROUTING_API_KEY=
OPENWEATHER_API_KEY=

SERPAPI_TIMEOUT_SECONDS=10
STAYING_API_TIMEOUT_SECONDS=12
STAYING_API_MAX_POLLS=6
STAYING_API_POLL_INTERVAL_SECONDS=1
GEOAPIFY_TIMEOUT_SECONDS=8
OPENWEATHER_TIMEOUT_SECONDS=8
LIVE_ROUTE_COST_PER_KM=12.00
